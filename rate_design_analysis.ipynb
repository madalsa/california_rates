    "iou_handles = [mpatches.Patch(facecolor='white', edgecolor='#333',\n",
    "                               hatch=iou_hatches[iou], label=iou)\n",
    "               for iou in iou_names]\n",
    "\n",
    "fig.legend(handles=rate_handles + [combo_handle] + iou_handles,\n",

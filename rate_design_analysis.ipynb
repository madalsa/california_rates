    "sq_base = 'tou_d_4_9_bill'\n",
    "sqf_base = 'tou_d_4_9_f_bill'\n",
    "rate_defs_cz = [\n",
    "    ('Current\\nFixed Chg', 'sqf',           False),\n",
    "    ('ROE\\nReduction',     'F0_WF0_ROE1.0', True),\n",
    "    ('Wildfire\\nRemoval',  'F0_WF1_ROE0',   True),\n",

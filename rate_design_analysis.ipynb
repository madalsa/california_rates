    "\n",
    "s = dfs['SCE'].copy()\n",
    "s['zone'] = s['cec_cz'].apply(\n",
    "    lambda z: 'Coastal/Mild' if z in sce_coastal\n",
    "    else ('Inland/Hot' if z in sce_inland_hot\n",

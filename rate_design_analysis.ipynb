    "print(f'SCE households with zone assignment: {len(s):,}')\n",
    "print(s.zone.value_counts())\n",
    "\n",
    "# ── SCE: Bill change ($/yr) by climate zone — 4x2 (CARE vs Non-CARE) ──\n",
    "df = s\n",
